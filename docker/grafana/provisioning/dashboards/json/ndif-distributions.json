  "panels": [
    {
      "id": 1,
      "type": "heatmap",
      "title": "Total request time \u2014 distribution over time",
      "description": "Per-request end-to-end time (sum of all lifecycle phases), bucketed over time. Bright bands = where most requests land; high outliers show a stretching tail.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"status_time\" and (r._field == \"duration_ms\" or r._field == \"request_id\") and r.model_key =~ /${model_key:regex}/ and r.service =~ /${service:regex}/ and r.environment =~ /${environment:regex}/ and (not exists r.api_key or r.api_key =~ /${api_key:regex}/) and (not exists r.email or r.email =~ /${email:regex}/))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"request_id\"])\n  |> reduce(\n      identity: {total: 0.0, _time: 1970-01-01T00:00:00Z},\n      fn: (r, accumulator) => ({\n        total: accumulator.total + r.duration_ms,\n        _time: r._time,\n      }),\n  )\n  |> group()\n  |> rename(columns: {total: \"_value\"})\n  |> keep(columns: [\"_time\", \"_value\"])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "calculation": {
          "yBuckets": {
            "mode": "count",
            "value": "20"
          }
        },
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64
        },
        "yAxis": {
          "unit": "ms"
        },
        "cellGap": 1,
        "tooltip": {
          "show": true,
          "yHistogram": true
        }
      }
    },
