        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({severity=\"error\", environment=~\"${environment:regex}\"} [$__range]))",
          "queryType": "instant",
          "legendFormat": "__auto",
          "refId": "A"
