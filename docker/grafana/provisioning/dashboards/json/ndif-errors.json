{
  "uid": "ndif-errors",
  "title": "NDIF — Errors & Health (Loki)",
  "tags": [
    "ndif",
    "loki"
  ],
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(environment)",
        "definition": "label_values(environment)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(service)",
        "definition": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "model_key",
        "label": "model_key",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(model_key)",
        "definition": "label_values(model_key)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "email",
        "label": "email",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "exception",
        "label": "exception type",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ],
        "hide": 0,
        "description": "Regex over exception_type. Set it to one class name to focus the tables and the stacktrace stream below."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ndif"
      ],
      "title": "NDIF",
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors",
      "description": "",
