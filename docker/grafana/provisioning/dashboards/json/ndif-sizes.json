          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"request_size\" and r._field == \"payload_bytes\" and r.model_key =~ /${model_key:regex}/ and r.service =~ /${service:regex}/ and r.environment =~ /${environment:regex}/ and (not exists r.api_key or r.api_key =~ /${api_key:regex}/) and (not exists r.email or r.email =~ /${email:regex}/))\n  |> group()\n  |> sum()",
          "refId": "A"
