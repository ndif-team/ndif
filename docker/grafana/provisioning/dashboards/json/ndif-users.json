      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT u.email, u.verification_status::text AS verification, COUNT(DISTINCT k.key_id) AS keys, MIN(u.created_at) AS joined FROM users u LEFT JOIN keys k ON k.user_id = u.user_id WHERE u.email = '${email}' GROUP BY u.email, u.verification_status",
          "rawQuery": true,
          "format": "table",
          "refId": "A"
        }
