    {
      "id": 10,
      "type": "table",
      "title": "Users leaderboard \u2014 email + usage",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT u.email, u.verification_status::text AS verification, string_agg(DISTINCT ut.name, ', ') AS tags FROM users u LEFT JOIN keys k ON k.user_id = u.user_id LEFT JOIN key_user_tag_assignments kuta ON kuta.key_id = k.key_id LEFT JOIN user_tags ut ON ut.user_tag_id = kuta.user_tag_id GROUP BY u.email, u.verification_status",
          "rawQuery": true,
          "format": "table",
          "refId": "user"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"request_size\" and r._field == \"payload_bytes\" and r.environment =~ /${environment:regex}/ and exists r.email)\n  |> group(columns: [\"email\"])\n  |> count()\n  |> keep(columns: [\"email\", \"_value\"])\n  |> group()",
          "refId": "requests"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"request_size\" and r._field == \"payload_bytes\" and r.environment =~ /${environment:regex}/ and exists r.email)\n  |> group(columns: [\"email\"])\n  |> sum()\n  |> keep(columns: [\"email\", \"_value\"])\n  |> group()",
          "refId": "bytes"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "email",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "_start": true,
              "_stop": true,
              "result": true,
              "table": true
            },
            "renameByName": {
              "_value 1": "Requests",
              "_value 2": "Bytes",
              "Value #requests": "Requests",
              "Value #bytes": "Bytes"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      },
      "description": "All users: Postgres email/tier joined to Influx usage on email (email is a metric tag)."
    }
