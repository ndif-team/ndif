# nnsight is vendored in this repo at ./nnsight (`pip install -e ./nnsight`).
# The monitor cron's remote-trace probe reconstructs models via
# nnsight.modeling.mixins.remotable.Remotable.from_model_key. peft / torchvision
# are only needed to probe PEFT / VLM checkpoints (e.g. VLM image processors).
peft
torchvision

# The reconcile cron drives deploy/evict/restart through the cli lib, which uses
# the Ray client (pinned to match services/ray). cli.lib.checks.check_redis and
# cli.lib.events.notify_reconcile need a redis client.
ray[client]==2.55.1
redis
