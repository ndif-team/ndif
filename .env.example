# =============================================================================
# NDIF Configuration
# =============================================================================
# Copy to .env and modify as needed. All variables have sensible defaults.

# -----------------------------------------------------------------------------
# Broker (Redis)
# -----------------------------------------------------------------------------
NDIF_BROKER_URL=redis://localhost:6379
NDIF_BROKER_PORT=6379

# -----------------------------------------------------------------------------
# Object Store (MinIO/S3)
# -----------------------------------------------------------------------------
NDIF_OBJECT_STORE_URL=http://localhost:27018
NDIF_OBJECT_STORE_PORT=27018
NDIF_OBJECT_STORE_CONSOLE_PORT=46805
NDIF_OBJECT_STORE_SERVICE=s3
NDIF_OBJECT_STORE_BUCKET=ndif-results
NDIF_OBJECT_STORE_ACCESS_KEY=minioadmin
NDIF_OBJECT_STORE_SECRET_KEY=minioadmin
NDIF_OBJECT_STORE_REGION=us-east-1
NDIF_OBJECT_STORE_VERIFY=false

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
NDIF_API_URL=http://localhost:5001
NDIF_API_PORT=5001
NDIF_API_WORKERS=1
NDIF_DEV_MODE=true

# -----------------------------------------------------------------------------
# Ray
# -----------------------------------------------------------------------------
NDIF_RAY_ADDRESS=ray://localhost:10001
NDIF_RAY_HEAD_PORT=6385
NDIF_RAY_CLIENT_PORT=10001
NDIF_RAY_DASHBOARD_PORT=8265
NDIF_RAY_SERVE_PORT=8262
NDIF_RAY_OBJECT_MANAGER_PORT=8076
NDIF_RAY_DASHBOARD_GRPC_PORT=8268
NDIF_RAY_TEMP_DIR=/tmp/ray

# -----------------------------------------------------------------------------
# Controller
# -----------------------------------------------------------------------------
NDIF_CONTROLLER_IMPORT_PATH=ndif.services.ray.deployments.controller.controller
NDIF_MINIMUM_DEPLOYMENT_TIME_SECONDS=0
# Dotted import path for the default Ray actor class used when a DeploymentConfig
# doesn't specify one. Override per-deployment via DeploymentConfig.actor_class.
NDIF_DEFAULT_MODEL_ACTOR_CLASS=ndif.services.ray.deployments.modeling.base.ModelActor
# How often the Controller heartbeats the current deployment state to InfluxDB
# (deployment_state / deployment_gpu measurements). On-change snapshots are
# emitted after every apply() regardless of this interval.
NDIF_DEPLOYMENT_METRIC_INTERVAL_S=30

# -----------------------------------------------------------------------------
# Autoscaling (Processor-side; one loop per model_key in the dispatcher)
# -----------------------------------------------------------------------------
# How often each Processor checks queue-head wait time.
NDIF_AUTOSCALING_INTERVAL_S=5
# Scale up when the oldest queued request has waited longer than this.
NDIF_AUTOSCALING_WAIT_THRESHOLD_S=30
# After scaling up, sleep this long before re-checking — lets the new
# replica come up and absorb queue depth before another scale-up fires.
NDIF_AUTOSCALING_BACKOFF_S=120
# Upper bound on the number of replicas a single model_key can be scaled
# to via autoscaling. Once this many replicas are running, the loop
# stops requesting more.
NDIF_AUTOSCALING_MAX_REPLICAS=3

# -----------------------------------------------------------------------------
# Dashboard (admin web app — see services/dashboard/)
# -----------------------------------------------------------------------------
# NDIF_DASHBOARD_PORT is intentionally unset here so `ndif start all` can use
# its presence as the "include dashboard in the stack" signal. Set it (in your
# shell, .env, or docker-compose env) to enable the dashboard.
# NDIF_DASHBOARD_PORT=8081
NDIF_DASHBOARD_USERNAME=admin
# bcrypt hash. Generate via:
#   python -m ndif.services.dashboard.backend.auth hash <password>
# Stored literally — compose loads it via env_file:format=raw so no escaping
# is needed. (The Makefile's -include mangles $-chars when exporting to the
# shell, but the dashboard service uses env_file rather than ${} interpolation
# for this var, so the mangled shell value is never consulted.)
NDIF_DASHBOARD_PASSWORD_HASH=
# Random ≥32-byte string used to sign session cookies. Generate via:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
NDIF_DASHBOARD_SESSION_SECRET=
# Where the monitor cron probes for connectivity. Local default points at
# the local API service. In prod override to the public URL (e.g.
# https://api.ndif.us) so the probe exercises the public path: DNS, TLS, LB.
NDIF_DASHBOARD_MONITOR_URL=http://localhost:5001
# API key the monitor cron uses for nnsight model traces (every 2h).
NDIF_API_KEY=
